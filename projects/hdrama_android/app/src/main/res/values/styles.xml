<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorControlNormal">#B6B5C8</item>
        <item name="android:textColorPrimary">#F6F5FA</item>
        <item name="android:textColorSecondary">#B6B5C8</item>
        <item name="android:colorAccent">@color/brand_accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">@color/app_background</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
</resources>
